# Base path the SPA uses to reach the backend. In dev, requests to this path
# are handled by the Vite proxy (see vite.config.ts). Leave as "/api" for the
# proxied local setup.
VITE_API_BASE_URL=/api

# Local dev proxy targets (used only by the Vite dev server, not the browser).
VITE_API_GATEWAY_URL=http://localhost:8080
VITE_AUTH_SERVICE_URL=http://localhost:8081

# Google OAuth client id for Google Sign-In. Leave empty to keep the Google
# button disabled. It must be the SAME client id the Auth Service validates
# against (GOOGLE_CLIENT_ID in docker-compose.core.yml): the Auth Service checks
# the ID token's `aud` claim, so a mismatch is rejected.
VITE_GOOGLE_CLIENT_ID=
