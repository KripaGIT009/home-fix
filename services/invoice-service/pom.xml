<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.homefix</groupId>
        <artifactId>homefix-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>com.homefix</groupId>
    <artifactId>invoice-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>HomeFix Invoice Service</name>
    <description>
        Invoice generation and delivery: consumes PaymentCompleted idempotently, renders a PDF
        invoice with an itemized price breakdown, stores it in S3 with server-side encryption,
        assigns globally-unique per-month invoice numbers (INV-YYYY-MM-NNNNNN), and delivers a
        72-hour signed URL to the customer via the Notification Service within 60 s. PDF
        generation retries up to 3x and alerts ops on exhaustion without blocking the payment
        flow. Also exposes customer invoice history (24-month retention) and provider monthly
        earnings statements (Requirement 13, Property 14). Built on the shared security,
        observability, and outbox libraries (Tasks 4-6).
    </description>

    <dependencies>
        <!-- ===== HomeFix shared libraries (Tasks 4-6) ===== -->
        <dependency>
            <groupId>com.homefix.shared</groupId>
            <artifactId>homefix-shared-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.homefix.shared</groupId>
            <artifactId>homefix-shared-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>com.homefix.shared</groupId>
            <artifactId>homefix-shared-resilience</artifactId>
        </dependency>
        <dependency>
            <groupId>com.homefix.shared</groupId>
            <artifactId>homefix-shared-outbox</artifactId>
        </dependency>
        <!-- Settings from the config.app_config table. -->
        <dependency>
            <groupId>com.homefix.shared</groupId>
            <artifactId>homefix-shared-config</artifactId>
        </dependency>

        <!-- ===== Spring Boot starters ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <!-- Schema migrations: src/main/resources/db/migration/invoice-service (V1 = baseline). -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- PostgreSQL support is a module of its own since Flyway 10. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== Kafka: PaymentCompleted consumption ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- ===== PDF rendering (OpenPDF, LGPL/MPL) ===== -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
        </dependency>

        <!-- ===== Runtime persistence driver ===== -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Micrometer Prometheus registry for /metrics (Requirement 25.4) ===== -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Test dependencies ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-memory DB for repository/integration slice tests -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- jqwik for property-based tests (Testing Strategy: Property-Based Tests) -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- JaCoCo coverage report (aligned with shared modules) -->
        </plugins>
    </build>
</project>
