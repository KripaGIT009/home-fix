<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.homefix</groupId>
    <artifactId>rating-review-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>HomeFix Rating &amp; Review Service</name>
    <description>
        Review submission with review-window enforcement (7-day prompt), integer 1-5 ratings on
        five dimensions with optional text and photo attachments, weighted aggregate recalculation
        (1.5x for reviews within 90 days, 1.0x otherwise, rounded to 2 dp), fraud detection
        (same-IP burst, star-rating deviation > 2 SD, freshly-created accounts) with flagged
        reviews held out of the aggregate until Admin approval, ReviewSubmitted event publishing
        via the shared outbox, automatic UNDER_REVIEW flagging when the aggregate drops below 3.0,
        and Admin moderation with Audit_Log entries (Requirement 15). Built on the shared security,
        observability, and outbox libraries (Tasks 4-6) and consumes the Payment Service's
        PaymentCompleted event (Task 18).
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>3.2.5</spring-boot.version>
        <homefix-shared.version>1.0.0-SNAPSHOT</homefix-shared.version>
        <jacoco.version>0.8.12</jacoco.version>
        <jqwik.version>1.8.4</jqwik.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ===== HomeFix shared libraries (Tasks 4-6) ===== -->
        <dependency>
            <groupId>com.homefix.shared</groupId>
            <artifactId>homefix-shared-security</artifactId>
            <version>${homefix-shared.version}</version>
        </dependency>
        <dependency>
            <groupId>com.homefix.shared</groupId>
            <artifactId>homefix-shared-observability</artifactId>
            <version>${homefix-shared.version}</version>
        </dependency>
        <dependency>
            <groupId>com.homefix.shared</groupId>
            <artifactId>homefix-shared-resilience</artifactId>
            <version>${homefix-shared.version}</version>
        </dependency>
        <dependency>
            <groupId>com.homefix.shared</groupId>
            <artifactId>homefix-shared-outbox</artifactId>
            <version>${homefix-shared.version}</version>
        </dependency>

        <!-- ===== Spring Boot starters ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== Runtime persistence driver ===== -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Micrometer Prometheus registry for /metrics (Requirement 25.4) ===== -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Test dependencies ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- jqwik for property-based tests (Testing Strategy: Property-Based Tests) -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
