{
  "consumer": {
    "name": "booking-service"
  },
  "messages": [
    {
      "contents": {
        "bookingId": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
        "bookingReference": "HF-2024-000123",
        "customerId": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
        "emailAddress": "customer@example.com",
        "mobileNumber": "+919812345678"
      },
      "description": "a booking-lifecycle notification event",
      "generators": {
        "body": {
          "$.bookingId": {
            "type": "Uuid"
          },
          "$.customerId": {
            "type": "Uuid"
          }
        }
      },
      "matchingRules": {
        "body": {
          "$.bookingId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            ]
          },
          "$.bookingReference": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.customerId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            ]
          },
          "$.emailAddress": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.mobileNumber": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        }
      },
      "metaData": {
        "contentType": "application/json"
      },
      "providerStates": [
        {
          "name": "a booking-lifecycle event is emitted for a customer"
        }
      ]
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.6.21"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "notification-service"
  }
}
